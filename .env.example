# Optional Compose settings. No passwords in this file.
HUB_HTTP_PORT=8080
HUB_TIME_ZONE=Europe/Moscow

# For a backend run outside Compose (use the generated secret file).
# HUB_DB_HOST=127.0.0.1
# HUB_DB_PORT=5432
# HUB_DB_NAME=eventhub
# HUB_DB_USER=eventhub
# HUB_DB_PASSWORD_FILE=/absolute/path/to/.local/secrets/db_password

HUB_DOCKER_SUBNET=172.31.51.0/24
# Standalone backend also requires these settings; HTTPS is the default.
# HUB_AUTH_SECRET_FILE=/absolute/path/to/.local/secrets/auth_secret
# HUB_ALLOWED_ORIGINS=["https://events.example.internal"]
# HUB_TRUSTED_PROXY_NETWORKS=[]

# Background processing (standalone backend/processes).
# HUB_REDIS_HOST=127.0.0.1
# HUB_REDIS_PORT=6379
# HUB_REDIS_PASSWORD_FILE=/absolute/path/to/.local/secrets/redis_password
# HUB_STORAGE_ROOT=/absolute/path/to/shared/blobs
# HUB_LEASE_SECONDS=60
# HUB_PUBLICATION_SECONDS=30
# HUB_ORPHAN_GRACE_SECONDS=86400

# Local SMTP listener (Compose host port).
HUB_SMTP_PORT=2525
# Standalone ingestion settings. Configure all receiving processes consistently.
# HUB_INGEST_MAX_BYTES=1048576
# HUB_INGEST_PER_MINUTE=120
# HUB_SMTP_ALLOWED_NETWORKS=["127.0.0.0/8","::1/128"]
# HUB_SMTP_RECIPIENTS=["events@localhost"]
# HUB_SMTP_TLS_CERT=/run/certificates/smtp.crt
# HUB_SMTP_TLS_KEY=/run/certificates/smtp.key
# HUB_SMTP_ALLOW_PLAINTEXT=false

# Исходящие подключения закрыты по умолчанию. Нужны точные имена и сети.
HUB_OUTBOUND_HOSTS=[]
HUB_OUTBOUND_NETWORKS=[]
HUB_OUTBOUND_PORTS=[443,465,587]
HUB_TELEGRAM_ALLOWED=false

# Повторы доставки: задержки в секундах, затем случайная добавка в процентах.
HUB_DELIVERY_RETRY_DELAYS=[30,120,600,1800]
HUB_DELIVERY_JITTER_PERCENT=10
# Корпоративные корневые сертификаты: смонтировать файл в API и обработчик доставки.
# HUB_OUTBOUND_CA_FILE=/run/certificates/outbound-ca.pem

# Параметры нагрузки. Сначала измерить профиль; значения ниже — локальные умолчания.
HUB_INGESTION_THREADS=2
HUB_DELIVERY_THREADS=2
HUB_DB_POOL_SIZE=5
HUB_DB_MAX_OVERFLOW=5
HUB_WORK_BATCH_SIZE=100
HUB_BACKGROUND_POLL_SECONDS=2
HUB_INGEST_PER_MINUTE=120
